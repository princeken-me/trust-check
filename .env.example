# ==============================================================================
# TRUSTCHECK PLATFORM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

APP_NAME="TrustCheck"
APP_ENV=production
APP_KEY=base64:trustcheck_production_app_key_32bytes_sec!
APP_DEBUG=false
APP_URL="https://trustcheck.org"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (PostgreSQL / MySQL / SQLite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trustcheck_db
DB_USERNAME=trustcheck_user
DB_PASSWORD=secret_secure_password_here

# Redis & Cache Settings
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Rate Limiting Parameters
RATE_LIMIT_PUBLIC_API_RPM=60
RATE_LIMIT_CHECK_REQUESTS_RPM=10

# Security & CORS Settings
CORS_ALLOWED_ORIGINS="https://trustcheck.org,https://admin.trustcheck.org"
SANCTUM_STATEFUL_DOMAINS="trustcheck.org,admin.trustcheck.org"

# External Intelligence & Data Providers (Configured in .env, Server-Only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
WHOIS_API_KEY="YOUR_WHOIS_SERVICE_KEY"
OPENCORPORATES_API_KEY="YOUR_OPENCORPORATES_API_KEY"
SEC_EDGAR_USER_AGENT="TrustCheck Compliance Operations (compliance@trustcheck.org)"

# Mail & Notification Settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.trustcheck.org
MAIL_PASSWORD=secret_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@trustcheck.org"
MAIL_FROM_NAME="TrustCheck Platform"
